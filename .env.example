# Supabase — Projekt-Einstellungen → API
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nur auf dem Server. Schreibt die Anfragen in die Tabelle `leads`, an der
# Zeilensicherheit vorbei — gehört nie in ein NEXT_PUBLIC_-Feld.
SUPABASE_SECRET_KEY=sb_secret_...

# Öffentliche Adresse der Seite, für Links in E-Mails. Erst setzen, wenn
# Impressum und Datenschutz vollständig sind: Damit wird die Seite für Google freigegeben.

SITE_URL=https://hohe-strasse.judek-projekt.de

# Optional: E-Mail an das Team bei jeder neuen Anfrage, über das IONOS-Postfach (SMTP).
# Fehlt das Passwort, wird die Anfrage trotzdem gespeichert — nur ohne Mail.
SMTP_PASSWORT=
# Standard: smtp.ionos.de und das Postfach hohe-strasse@judek-projekt.de
# SMTP_HOST=smtp.ionos.de
# SMTP_BENUTZER=hohe-strasse@judek-projekt.de
# Mehrere Empfänger mit Komma trennen. Leer = Standard aus lib/mail.ts
# (immobilien@daniel-diener.de, immobilien@lena-mylin.de).
LEAD_BENACHRICHTIGUNG_AN=
# Terminbestätigungen für den Gastgeber. Leer = r.judek@judek.de (lib/mail.ts).
TERMIN_BENACHRICHTIGUNG_AN=
# Optional: schützt /api/cron/einladungen. Vercel schickt den Wert bei Cron-Läufen mit.
CRON_SECRET=
# 1 = Interessent:in bekommt eine Eingangsbestätigung
ANFRAGE_BESTAETIGUNG=1
