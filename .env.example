# Supabase — Projekt-Einstellungen → API
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nur auf dem Server. Schreibt die Anfragen in die Tabelle `leads`, an der
# Zeilensicherheit vorbei — gehört nie in ein NEXT_PUBLIC_-Feld.
SUPABASE_SECRET_KEY=sb_secret_...

# Öffentliche Adresse der Seite, für Links in E-Mails. Erst setzen, wenn
# Impressum und Datenschutz vollständig sind: Damit wird die Seite für Google freigegeben.
# Die Domain hohe-straße-hohenhameln.de hat ein ß; hier in der
# Punycode-Schreibweise, die überall funktioniert (Browser zeigen das ß an).
SITE_URL=https://xn--hohe-strae-hohenhameln-y1b.de

# Optional: E-Mail an das Team bei jeder neuen Anfrage (Resend, https://resend.com).
# Fehlt der Schlüssel, wird die Anfrage trotzdem gespeichert — nur ohne Mail.
RESEND_API_KEY=
MAIL_ABSENDER="Hohe Straße Hohenhameln <anfrage@xn--hohe-strae-hohenhameln-y1b.de>"
LEAD_BENACHRICHTIGUNG_AN=vertrieb@example.de
# 1 = Interessent:in bekommt eine Eingangsbestätigung
ANFRAGE_BESTAETIGUNG=1
